generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Null for accounts created through Google sign-in — they have no password
  // of their own. Every password check must handle that.
  passwordHash  String?
  name          String?
  avatarUrl     String?   @db.Text
  // "user" | "admin" — admins reach the admin panel. Plain strings rather
  // than enums so adding a tier later doesn't need a migration dance.
  role          String    @default("user")
  // "active" | "disabled" — disabled accounts are refused at login.
  status        String    @default("active")
  // "free" | "premium" — no billing wired up yet; set manually or by voucher.
  plan          String    @default("free")
  // When a voucher-granted premium period runs out. Null means the plan was
  // set by hand and doesn't expire on its own.
  premiumUntil  DateTime?
  createdAt     DateTime  @default(now())

  projects       Project[]
  glimpses       Glimpse[]
  documents      Document[]
  writingDates   WritingDate[]
  writingSessions WritingSession[]
  redemptions    VoucherRedemption[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  glimpses        Glimpse[]
  documents       Document[]
  writingDates    WritingDate[]
  writingSessions WritingSession[]

  @@index([userId])
}

enum GlimpseType {
  text
  voice
  image
  link
}

model Glimpse {
  id         String      @id @default(cuid())
  userId     String
  projectId  String
  type       GlimpseType @default(text)
  content    String
  transcript String?
  audioUrl   String?
  imageUrl   String?
  linkUrl    String?
  pinned     Boolean     @default(false)
  positionX  Float?
  positionY  Float?
  rotation   Float?      @default(0)
  color      String?
  createdAt  DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model Document {
  id            String   @id @default(cuid())
  userId        String
  projectId     String
  title         String
  writingFormat String   @default("plain-white")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  sessions WritingSession[]

  @@index([userId])
  @@index([projectId])
}

model Chapter {
  id         String   @id @default(cuid())
  documentId String
  title      String
  content    String   @default("")
  orderIndex Int      @default(0)
  wordCount  Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model WritingDate {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  title        String?
  note         String?
  scheduledFor DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([scheduledFor])
}

model WritingSession {
  id           String    @id @default(cuid())
  userId       String
  projectId    String
  documentId   String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  wordsWritten Int       @default(0)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
}

// Messages sent through the public Support page's contact form. Not tied
// to a user account -- logged-out visitors can reach Support too.
model SupportMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A redeemable code that grants Premium for a stretch of time. There's no
// billing yet, so a voucher is simply a gift of access rather than a discount
// off a price.
model Voucher {
  id          String    @id @default(cuid())
  code        String    @unique
  label       String
  monthsAdded Int       @default(1)
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  redemptions VoucherRedemption[]

  @@index([code])
  @@index([createdAt])
}

model VoucherRedemption {
  id         String   @id @default(cuid())
  voucherId  String
  userId     String
  redeemedAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One redemption per person per code — stops a single code being farmed.
  @@unique([voucherId, userId])
  @@index([userId])
}

// A broadcast shown to every signed-in writer until they dismiss it.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  // "info" | "event" | "maintenance" — drives the accent colour only.
  kind      String   @default("info")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
